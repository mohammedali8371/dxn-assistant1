# ===== DXN Assistant - VPS Environment =====
# انسخ هذا الملف إلى .env على الخادم واملأ القيم الحقيقية هناك فقط
# لا ترفع .env أبداً إلى أي مستودع عام

API_ID=CHANGE_ME
API_HASH=CHANGE_ME
PHONE=CHANGE_ME

# الجلسة مشفّرة AES-256-GCM (مستحسن) — أو SESSION_STRING للجلسة النصية
# ولّد SESSION_ENC عبر: node deploy/encrypt_session.mjs
SESSION_ENC=CHANGE_ME
SESSION_KEY=CHANGE_ME
# SESSION_STRING=CHANGE_ME

# بوت التحكم
ADMIN_BOT_TOKEN=CHANGE_ME

# المصادر الخارجية
MONGO_URI=CHANGE_ME
FIREBASE_KEY=CHANGE_ME
EXTRA_ACCESS_TOKEN=CHANGE_ME

# إعدادات إضافية
ASSISTANT_NAME=مساعد DXN
DASHBOARD_PASSWORD=admin123
PORT=3000
NODE_ENV=production
OPENAI_API_KEY=
CHUNK_SIZE=1000
TOP_K=5
TEMPERATURE=0.7
